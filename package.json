{
  "name": "taintgate",
  "version": "0.1.0",
  "description": "TaintGate — a taint-aware governance proxy (Policy Enforcement Point) for the Model Context Protocol (MCP)",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "bin": {
    "taintgate": "dist/cli/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./interfaces": {
      "types": "./dist/interfaces/index.d.ts",
      "import": "./dist/interfaces/index.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/types/index.js"
    }
  },
  "scripts": {
    "build": "tsc && node src/cli/build.mjs",
    "build:watch": "tsc --watch",
    "type-check": "tsc --noEmit",
    "start": "node dist/cli/index.js",
    "dev": "tsx src/cli/index.ts",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch --passWithNoTests",
    "test:coverage": "jest --coverage --passWithNoTests",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run build && npm run type-check"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "security",
    "governance",
    "policy-enforcement",
    "pep",
    "pdp",
    "xacml",
    "ai-safety",
    "agent-governance",
    "taint-tracking",
    "information-flow-control",
    "mcp-proxy",
    "dlp"
  ],
  "author": "TaintGate Contributors",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/kiranv926/taintgate.git"
  },
  "bugs": {
    "url": "https://github.com/kiranv926/taintgate/issues"
  },
  "homepage": "https://github.com/kiranv926/taintgate#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "zod": "^3.22.4"
  },
  "peerDependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0"
  },
  "peerDependenciesMeta": {
    "@modelcontextprotocol/sdk": {
      "optional": true
    }
  },
  "devDependencies": {
    "@jest/core": "^29.7.0",
    "@jest/globals": "^30.4.1",
    "@jest/test-sequencer": "^29.7.0",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "esbuild": "^0.28.1",
    "eslint": "^8.54.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "tsx": "^4.23.0",
    "typescript": "^5.3.2"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "ARCHITECTURE.md",
    "SECURITY.md"
  ]
}
